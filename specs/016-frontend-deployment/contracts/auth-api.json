{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthAPIContracts",
  "description": "API contracts for authentication and password change flows between Frontend and Backend",
  "endpoints": {
    "login": {
      "method": "POST",
      "path": "/api/v1/auth/login",
      "request": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "required": ["success", "data"],
          "properties": {
            "success": { "type": "boolean" },
            "message": { "type": "string" },
            "data": {
              "type": "object",
              "required": ["accessToken", "refreshToken", "expiresIn", "user"],
              "properties": {
                "accessToken": { "type": "string" },
                "refreshToken": { "type": "string" },
                "expiresIn": { "type": "integer" },
                "user": {
                  "type": "object",
                  "required": ["id", "email", "firstName", "lastName", "role", "storeId", "storeName", "mustChangePassword"],
                  "properties": {
                    "id": { "type": "string", "format": "uuid" },
                    "email": { "type": "string" },
                    "firstName": { "type": "string" },
                    "lastName": { "type": "string" },
                    "role": { "type": "string" },
                    "storeId": { "type": "string", "format": "uuid" },
                    "storeName": { "type": "string" },
                    "mustChangePassword": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "changePassword": {
      "method": "POST",
      "path": "/api/v1/auth/change-password",
      "headers": {
        "Authorization": "Bearer {accessToken}"
      },
      "request": {
        "type": "object",
        "required": ["currentPassword", "newPassword"],
        "properties": {
          "currentPassword": { "type": "string" },
          "newPassword": { "type": "string", "minLength": 8 }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "required": ["success", "data"],
          "properties": {
            "success": { "type": "boolean" },
            "message": { "type": "string" },
            "data": { "type": "boolean" }
          }
        }
      }
    },
    "me": {
      "method": "GET",
      "path": "/api/v1/auth/me",
      "headers": {
        "Authorization": "Bearer {accessToken}"
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "required": ["success", "data"],
          "properties": {
            "success": { "type": "boolean" },
            "data": {
              "type": "object",
              "required": ["id", "email", "firstName", "lastName", "role", "store", "mustChangePassword"],
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "email": { "type": "string" },
                "firstName": { "type": "string" },
                "lastName": { "type": "string" },
                "role": { "type": "string" },
                "mustChangePassword": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
