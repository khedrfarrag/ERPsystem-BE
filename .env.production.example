# ==============================================================================
# RetailOS Production Environment Variables (TEMPLATE ONLY)
# DO NOT PUT REAL SECRETS IN THIS TEMPLATE FILE!
# To deploy: Copy this file to .env on your private VPS server and restrict permissions:
#   cp .env.production.example .env
#   chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Domain & SSL Settings
# ------------------------------------------------------------------------------
# Replace with your actual registered domain name (e.g., app.yourdomain.com)
DOMAIN=app.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# ------------------------------------------------------------------------------
# PostgreSQL Database Credentials (ISOLATED - NOT EXPOSED TO PUBLIC INTERNET)
# ------------------------------------------------------------------------------
POSTGRES_DB=retailos_prod
POSTGRES_USER=retailos_admin
# Generate a strong random password (e.g. openssl rand -hex 16):
POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_POSTGRES_PASSWORD_HERE

# ------------------------------------------------------------------------------
# JWT Authentication Security
# ------------------------------------------------------------------------------
# Generate a strong 256-bit key (e.g. openssl rand -base64 48):
JWT_SECRET=GENERATE_STRONG_RANDOM_JWT_SECRET_KEY_MIN_32_CHARS_HERE

# ------------------------------------------------------------------------------
# AI Invoice Scanner (Optional API Key - Keep Blank if unused)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=YOUR_AI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-pro

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
TZ=Africa/Cairo
